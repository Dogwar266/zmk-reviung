#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        home_row_mods: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <13 14 15 16 19 20 21 22>;
            tapping-term-ms = <500>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |   BSPC    |
            // | CTRL |  &mt LCTRL A | &mt LALT S  | &mt LGUI D  | &mt LSHIFT F  |  G  |   |  H  | &mt RSHIFT J |  &mt RGUI K  | &mt RALT L  |  &mt RCTRL ;  |    '      |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT(RET) |
            //                         | ALT | SPC | RGB 

            bindings = <
&kp TAB    &kp Q                          &kp W                      &kp E                      &kp R                        &kp T         &kp Y  &kp U                         &kp I                       &kp O                       &kp P                                   &kp BSPC
&kp LCTRL  &home_row_mods LEFT_CONTROL A  &home_row_mods LEFT_ALT S  &home_row_mods LEFT_GUI D  &home_row_mods LEFT_SHIFT F  &kp G         &kp H  &home_row_mods RIGHT_SHIFT J  &home_row_mods RIGHT_GUI K  &home_row_mods RIGHT_ALT L  &home_row_mods RIGHT_CONTROL SEMICOLON  &kp SQT
&kp LSHFT  &kp Z                          &kp X                      &kp C                      &kp V                        &kp B         &kp N  &kp M                         &kp COMMA                   &kp DOT                     &kp FSLH                                &mt RSHFT RET
                                                                     &to 1                      &kp SPACE                           &to 2
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------
            // |    |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |      DEL    |
            // |    |  _  |  +  |  {  |  }  | "|" |   | LFT | DWN |  UP | RGT |  `  |       ~     |
            // |    | ESC | GUI | ALT | CAPS|  "  |   | HOME| END | PGUP| PGDN| PRSC| SHFT(SPACE) |
            //                       |     |     | RET | ADJ |     |

            bindings = <
&trans  &kp EXCL   &kp AT    &kp HASH  &kp DLLR   &kp PRCNT         &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR   &trans
&trans  &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC   &kp PIPE          &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &kp GRAVE  &kp TILDE
&trans  &kp ESC    &kp LGUI  &kp LALT  &kp CLCK   &kp DQT           &kp HOME   &kp END   &kp PG_UP  &kp PG_DN  &kp PSCRN  &mt RSHFT SPACE
                             &to 0     &kp SPACE             &to 1
            >;
        };

        raise_layer {
            // ----------------------------------------------------------------------------
            // |    |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL |
            // |    |  -  |  =  |  [  |  ]  |  \  |   | F1  | F2  | F3  | F4  | F5  | F6  |
            // |    | ESC | GUI | ALT | CAPS|  "  |   | F7  | F8  | F9  | F10 | F11 | F12 |
            //                       |     | ADJ | BSPC |    |     |

            bindings = <
&trans  &kp N1     &kp N2     &kp N3    &kp N4    &kp N5           &kp N6  &kp N7  &kp N8  &kp N9   &kp N0   &kp BACKSPACE
&trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH         &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&trans  &kp ESC    &kp LGUI   &kp RALT  &kp CLCK  &kp DQT          &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
                              &trans    &mo 3               &to 0
            >;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            // | RGB BRI+ | RGB SAT+ | RGB HUE+ | RGB ANI+ |    | RGB TOG |   |  BT1  | BT2 | BT3 | BT4 | BT5 | BT CLR |
            // | RGB BRI- | RGB SAT- | RGB HUE- | RGB ANI- |    |         |   |       |     |     |     |     |        |
            // |          |          |          |          |    |         |   | RESET |     |     |     |     |        |
            //                                              |     |     |     |     |     |

            bindings = <
&rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_EFF  &none   &rgb_ug RGB_TOG          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_EFR  &none   &none                    &none         &none         &none         &none         &none         &none
&none            &none            &none            &none            &none   &none                    &sys_reset    &none         &none         &none         &none         &bootloader
                                                   &trans           &trans                   &tog 3
            >;
        };
    };
};
